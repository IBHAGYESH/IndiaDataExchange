PORT=5055
CORS_ORIGIN=http://localhost:5173

# IDE API — used for x402 purchase/download (agent wallet signs on this host)
IDE_API_BASE_URL=http://localhost:5001

# MCP server — discovery only (ide_list_datasets, ide_get_dataset); no trailing slash
IDE_MCP_BASE_URL=http://localhost:5056

# Optional: same value as MCPServer MCP_API_KEY (Authorization: Bearer)
# IDE_MCP_API_KEY=

# Public marketplace URLs shown in purchase confirmation (Next.js app, dataset page /marketplace/:id)
IDE_FRONTEND_BASE_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=sk-...

# Algorand testnet — agent (buyer) wallet for x402; must hold ALGO + USDC on the IDE ASA
AGENT_ALGOD_MNEMONIC="your twenty five word mnemonic here ..."

# Optional: refuse to buy datasets above this USDC price (demo guardrail)
MAX_DATASET_PRICE_USDC=5

# Optional: max bytes to read from downloaded file (default 1048576)
# MAX_DOWNLOAD_BYTES=1048576

# Optional: limit passed to ide_list_datasets (default 50)
# MCP_LIST_DATASETS_LIMIT=50

# Alternative to mnemonic: base64-encoded 64-byte Algorand secret key
# AGENT_PRIVATE_KEY=
