# Server
PORT=5001
NODE_ENV=development

# Public API origin for absolute URLs in JSON (e.g. purchaseApiUrl).
# Production (Netlify): API_PUBLIC_BASE_URL=https://ideapi.ibhagyesh.com
# Local: API_PUBLIC_BASE_URL=http://localhost:5001

# Set automatically in backend/netlify.toml for serverless deploy (6MB upload/body limits).
# NETLIFY=true

# MongoDB
MONGODB_URI=mongodb://localhost:27017/india-data-exchange

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Algorand
ALGORAND_TESTNET_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
USDC_ASSET_ID=10458941

# Smart Contract (deploy and set app ID here)
BOUNTY_CONTRACT_APP_ID=0

# Pinata IPFS
PINATA_API_KEY=your-pinata-api-key
PINATA_API_SECRET=your-pinata-api-secret
PINATA_GATEWAY_TOKEN=your-pinata-gateway-token

# x402 / GoPlausible Facilitator
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Platform Admin Algorand Wallet Address
ADMIN_WALLET_ADDRESS=your-admin-algorand-wallet-address

# Platform Fee (optional)
PLATFORM_FEE_PERCENTAGE=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
