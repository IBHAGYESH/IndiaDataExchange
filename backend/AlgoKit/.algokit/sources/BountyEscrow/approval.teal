#pragma version 11
#pragma typetrack false


main:
    intcblock 0 1 2 10458941
    bytecblock "bounty_" 0x151f7c750020


    txn NumAppArgs
    bz main___algots__.defaultCreate@12
    txn OnCompletion
    !
    assert
    txn ApplicationID
    assert
    pushbytess 0xd942c875 0xe432ab9f 0xa68c40e1 0x1bc72dd9 0x54254f0a
    txna ApplicationArgs 0
    match postBounty acceptSubmission refundBounty getBountyEscrow fundContract
    err

main___algots__.defaultCreate@12:


    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    assert
    intc_1
    return



